---
import Layout from '../layouts/Layout.astro';
import DessertItem from '../components/DessertItem.astro';

const desserts = [
  { id: 1, name: 'Torta de Limón', description: 'Deliciosa torta decorada con corona y rodajas de limón fresco.', price: 30.00, image: '/tortaLimon.jpeg' },
  { id: 2, name: 'Tres Leches mediana', description: 'Clásico postre esponjoso bañado en tres leches con suave merengue.', price: 3.00, image: '/3leches.jpeg' },
  { id: 3, name: 'Tres Leches grande', description: 'Clásico postre esponjoso bañado en tres leches con suave merengue.', price: 15.00, image: '/3leches.jpeg' },
  { id: 4, name: 'Galletas Craqueladas de Chocolate', description: 'Deliciosas trufas de chocolate espolvoreadas con azúcar impalpable. Son 3 galles ', price: 1.50, image: '/bolasChocolate.jpeg' },
  { id: 5, name: 'Brownie', description: 'Rico y denso brownie de chocolate cubierto con fudge especial.', price: 8.50, image: '/brownie.jpeg' },
  { id: 6, name: 'Galletas Chocochips', description: 'Galletas caseras clásicas empacadas individualmente.', price: 1.70, image: '/galletas.jpeg' },
  { id: 7, name: 'Pie de Limón', description: 'Pie clásico con relleno de limón y abundante merengue tostado.', price: 14.00, image: '/pieLimon.jpeg' },
  { id: 8, name: 'Torta de Arequipe', description: 'Torta festiva de Arequipe decorada con chispas de colores y bolitas de chocolate.', price: 25.00, image: '/tortaChocolate.jpeg' }
];
---
<Layout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="text-center mb-16 flex flex-col items-center">
      <div class="relative mb-6 group">
        <div class="absolute -inset-1 bg-gradient-to-r from-amber-500 to-amber-700 rounded-full blur opacity-40 group-hover:opacity-75 transition duration-500"></div>
        <img 
          src="/sugarBlackLogo.svg" 
          alt="Sugar Black Logo" 
          class="relative w-40 h-40 object-contain rounded-full bg-black p-1"
        />
      </div>
      
      <h1 class="text-4xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-600 mb-3 tracking-wide">
        Menú de Postres
      </h1>
      <p class="text-zinc-400 text-lg max-w-md mx-auto font-light">
        Descubre la dulzura en cada bocado
      </p>
    </header>
    
    <main class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      {desserts.map((dessert) => (
        <DessertItem 
          name={dessert.name} 
          description={dessert.description} 
          price={dessert.price} 
          image={dessert.image} 
        />
      ))}
    </main>

    <footer class="mt-20 pt-8 border-t border-zinc-900 text-center text-zinc-600 text-sm">
      <p>© Sugar Black. Todos los derechos reservados.</p>
    </footer>
  </div>
</Layout>