---
import Layout from '../layouts/Layout.astro';
import DessertItem from '../components/DessertItem.astro';

const desserts = [
  { id: 1, name: 'Torta de Limón', description: 'Torta de vainilla rellena de curd de limón o crema pastelera de limón con un glaseado de limón.', price: 30.00, image: '/tortaLimon.jpeg' },
  { id: 2, name: 'Tres Leches mediana', description: 'bizcocho de vainilla humedecido con una salsa de leches, leche condensada y crema de leche, con un toque de ron y canela, junto a un merengue suizo por encima, aproximadamente de un tamaño de 10x16 cm.', price: 3.00, image: '/3leches.jpeg' },
  { id: 3, name: 'Tres Leches grande', description: ' bizcocho de vainilla humedecido con una salsa de leches, leche condensada y crema de leche, con un toque de ron y canela, junto a un merengue suizo por encima, aproximadamente de un tamaño de 24x40 cm.', price: 15.00, image: '/3leches.jpeg' },
  { id: 4, name: 'Galletas Craqueladas de Chocolate', description: 'galletas de chocolate espolvoreadas con azúcar impalpable (3 uni c/u) ', price: 1.50, image: '/bolasChocolate.jpeg' },
  { id: 5, name: 'Brownie', description: 'Denso y chocolatoso brownie relleno y cubierto de una crema de cacao, opcionalmente con trozos de chocolate partido y frutos secos como nueces, almendras, maní, etc.', price: 8.50, image: '/brownie.jpeg' },
  { id: 6, name: 'Galletas Chocochips', description: 'Galletas clásicas de chispas de chocolates con un sabor marcado a galletas toddy, opcionalmente rellenas de crema de chocolate con avellanas, crema de maní, crema de pistacho, arequipe, etc.', price: 1.70, image: '/galletas.jpeg' },
  { id: 7, name: 'Pie de Limón', description: 'Pie clásico de limón, con base de una masa quebrada, crema de limón clásica y un merengue suizo firme y cremoso.', price: 14.00, image: '/pieLimon.jpeg' },
  { id: 8, name: 'Torta de Arequipe', description: 'Torta de vainilla o marmoleada rellena y cubierta de arequipe repostero junto a varias gotas de chocolate en su relleno y decoraciones de chocolate y lluvia de colores por encima.', price: 25.00, image: '/tortaChocolate.jpeg' }
];
---
<Layout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="text-center mb-16 flex flex-col items-center">
      <div class="relative mb-6 group">
        <div class="absolute -inset-1 bg-gradient-to-r from-amber-500 to-amber-700 rounded-full blur opacity-40 group-hover:opacity-75 transition duration-500"></div>
        <img 
          src="/sugarBlackLogo.svg" 
          alt="Sugar Black Logo" 
          class="relative w-40 h-40 object-contain rounded-full bg-black p-1"
        />
      </div>
      
      <h1 class="text-4xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-600 mb-3 tracking-wide">
        Menú de Postres
      </h1>
      <p class="text-zinc-400 text-lg max-w-md mx-auto font-light">
        Descubre la dulzura en cada bocado
      </p>
    </header>
    
    <main class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      {desserts.map((dessert) => (
        <DessertItem 
          name={dessert.name} 
          description={dessert.description} 
          price={dessert.price} 
          image={dessert.image} 
        />
      ))}
    </main>

    <footer class="mt-20 pt-8 border-t border-zinc-900 text-center text-zinc-600 text-sm">
      <p>© Sugar Black. Todos los derechos reservados.</p>
    </footer>
  </div>
</Layout>