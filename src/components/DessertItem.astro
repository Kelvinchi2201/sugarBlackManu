---
export interface Props {
  name: string;
  description: string;
  price: number;
  image: string;
}

const { name, description, price, image } = Astro.props;
---
<article class="bg-zinc-900/90 border border-amber-500/20 rounded-3xl overflow-hidden shadow-xl hover:border-amber-500/60 hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-2 transition-all duration-300 flex flex-col h-full group">
  <div class="w-full h-56 overflow-hidden bg-zinc-800 relative">
    <img 
      src={image} 
      alt={name} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" 
      loading="lazy" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-900 via-transparent to-transparent opacity-60"></div>
  </div>
  
  <div class="p-6 flex flex-col flex-grow text-center">
    <h2 class="text-2xl font-bold text-amber-100 mb-2 font-serif tracking-wide">{name}</h2>
    <p class="text-zinc-400 text-sm mb-6 flex-grow leading-relaxed">{description}</p>
    
    <div class="mt-auto">
      <span class="inline-block bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 text-zinc-950 font-black px-6 py-2.5 rounded-full text-lg shadow-lg shadow-amber-500/20 tracking-wider">
        ${price.toFixed(2)}
      </span>
    </div>
  </div>
</article>